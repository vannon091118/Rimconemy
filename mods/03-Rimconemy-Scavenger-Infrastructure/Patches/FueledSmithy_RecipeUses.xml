<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase-First Vanilla Patch (Task 7 — Vanilla-Patches Stufe 1).

  Purpose:
    Additive Stufe-1-PatchOperationAdd on Vanilla `FueledSmithy`. Two anchors:
      - <recipes>         (modern RimWorld on the building def)
      - <recipeUsers>     (security fallback in case <recipes> is missing)
    Rimconemy_BurnSteelScraps joins both lists so Vanilla recipe registration
    is robust against schema drift.

  Patch risk tier: STUFE 1 (Add only).
  Idempotence: explicit `not(... li[...Rimconemy_BurnSteelScraps])` guard
    so re-load/save-modState-ReSync does not duplicate the entry. Verified
    pattern: see also `mods/03/Source/HarmonyPatches/BauschuttRemapApply.cs`
    PatchOperationAdd-on-list calls elsewhere in the repo.

  Vanilla anchor: game/Data/Core/Defs/ThingDefs_Buildings/Buildings_Production.xml (FueledSmithy).
-->
<Patch>

  <Operation Class="PatchOperationSequence">
      <success>Always</success>
      <operations>

        <li Class="PatchOperationTest">
          <xpath>/Defs/ThingDef[defName="FueledSmithy"]</xpath>
        </li>

        <!-- Patch <recipes> on the building def. Idempotent via the not() guard. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="FueledSmithy"][not(recipes/li[text()="Rimconemy_BurnSteelScraps"])]/recipes</xpath>
          <order>Prepend</order>
          <value>
            <li>Rimconemy_BurnSteelScraps</li>
          </value>
        </li>

        <!--
          Belt-and-braces: if the building def carries <recipeUsers> (legacy 1.0/1.1
          schema), keep that field in sync. Rimconemy_WoodCoalGenerator-style
          additive-anchor pattern. Idempotent: only adds when missing.
        -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="FueledSmithy"][not(recipeUsers/li[text()="Rimconemy_BurnSteelScraps"])]/recipeUsers</xpath>
          <order>Prepend</order>
          <value>
            <li>Rimconemy_BurnSteelScraps</li>
          </value>
        </li>

    </operations>
  </Operation>

</Patch>
