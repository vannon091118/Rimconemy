<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Scavenger Infrastructure (Package 03)
  Task 3.2: Bauschutt Wall/Door Remap & Debris Recycling Patches.
  Task 3.11: Remove Woody from Wall/Door stuffCategories.
  Target RimWorld 1.6.4566.

  Design Decision (2026-08-04):
  In the Rimconemy survival loop, wood is NOT a building material for walls/doors.
  Walls require either:
    - Stony (ConstructionDebris / Bauschutt) — scavenged rubble
    - Metallic (Steel) — reclaimed from steel scraps via campfire
  This forces the player into the scavenging loop: ruins → scraps → campfire → steel → walls.
-->
<Patch>
  <!-- ═══════════════════════════════════════════════════════════════
       PART 1: REGISTER THE IMMEDIATE BAUSCHUTT WALL DESIGNATOR
       The node exists in Core 1.6; the conditional keeps this patch safe
       if a compatible Core changes that shape.
       ═══════════════════════════════════════════════════════════════ -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/DesignationCategoryDef[defName="Structure"]/specialDesignatorClasses[not(li[text()="Rimconemy.ScavengerInfrastructure.Building.Designator_BuildWallBauschutt"])]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/DesignationCategoryDef[defName="Structure"]/specialDesignatorClasses</xpath>
      <value><li>Rimconemy.ScavengerInfrastructure.Building.Designator_BuildWallBauschutt</li></value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/DesignationCategoryDef[defName="Structure"][not(specialDesignatorClasses)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/DesignationCategoryDef[defName="Structure"]</xpath>
      <value>
        <specialDesignatorClasses>
          <li>Rimconemy.ScavengerInfrastructure.Building.Designator_BuildWallBauschutt</li>
        </specialDesignatorClasses>
      </value>
    </match>
  </Operation>

  <!-- ═══════════════════════════════════════════════════════════════
       PART 2: REMOVE WOODY FROM WALL/DOOR STUFF CATEGORIES
       Rimconemy does not allow wood walls. Wood stays as fuel only.
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Remove Woody from Wall if it exists in the list -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Wall"]/stuffCategories/li[text()="Woody"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="Wall"]/stuffCategories/li[text()="Woody"]</xpath>
    </match>
  </Operation>

  <!-- Remove Woody from Door if it exists in the list -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[@Name="DoorBase"]/stuffCategories/li[text()="Woody"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[@Name="DoorBase"]/stuffCategories/li[text()="Woody"]</xpath>
    </match>
  </Operation>

  <!-- ═══════════════════════════════════════════════════════════════
       PART 3: ADD STONY TO WALL/DOOR (existing patches)
       Walls/Doors accept Stony (Bauschutt/ConstructionDebris) material.
       ═══════════════════════════════════════════════════════════════ -->

  <!-- Add Stony to an existing Wall category only when it is not already present. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Wall"]/stuffCategories[not(li[text()="Stony"])]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Wall"]/stuffCategories</xpath>
      <value><li>Stony</li></value>
    </match>
  </Operation>

  <!-- Create the Wall category list only when the vanilla node is absent. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Wall"][not(stuffCategories)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Wall"]</xpath>
      <value>
        <stuffCategories>
          <li>Stony</li>
          <li>Metallic</li>
        </stuffCategories>
      </value>
    </match>
  </Operation>

  <!-- Add Stony to an existing Door category only when it is not already present. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[@Name="DoorBase"]/stuffCategories[not(li[text()="Stony"])]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[@Name="DoorBase"]/stuffCategories</xpath>
      <value><li>Stony</li></value>
    </match>
  </Operation>

  <!-- Create the Door category list only when the vanilla node is absent. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[@Name="DoorBase"][not(stuffCategories)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[@Name="DoorBase"]</xpath>
      <value>
        <stuffCategories>
          <li>Stony</li>
          <li>Metallic</li>
        </stuffCategories>
      </value>
    </match>
  </Operation>
</Patch>
