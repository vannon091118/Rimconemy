<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Scavenger Infrastructure (Package 03)
  Task 3.2: Bauschutt Wall/Door Remap & Debris Recycling Patches.
  Target RimWorld 1.6.4566.
-->
<Patch>
  <!-- Add Stony to an existing Wall category only when it is not already present. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Wall"]/stuffCategories[not(li[text()="Stony"])]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Wall"]/stuffCategories</xpath>
      <value><li>Stony</li></value>
    </match>
  </Operation>

  <!-- Create the Wall category list only when the vanilla node is absent. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Wall"][not(stuffCategories)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Wall"]</xpath>
      <value>
        <stuffCategories>
          <li>Stony</li>
          <li>Woody</li>
          <li>Metallic</li>
        </stuffCategories>
      </value>
    </match>
  </Operation>

  <!-- Add Stony to an existing Door category only when it is not already present. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Door"]/stuffCategories[not(li[text()="Stony"])]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Door"]/stuffCategories</xpath>
      <value><li>Stony</li></value>
    </match>
  </Operation>

  <!-- Create the Door category list only when the vanilla node is absent. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Door"][not(stuffCategories)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Door"]</xpath>
      <value>
        <stuffCategories>
          <li>Stony</li>
          <li>Woody</li>
          <li>Metallic</li>
        </stuffCategories>
      </value>
    </match>
  </Operation>
</Patch>
