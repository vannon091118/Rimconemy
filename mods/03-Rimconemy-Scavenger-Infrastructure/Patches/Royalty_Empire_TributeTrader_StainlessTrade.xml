<?xml version="1.0" encoding="utf-8"?>
<!--
  Phase-First DLC Adapter (Task 14 — Royalty).

  Purpose:
    Additive Stufe-1-PatchOperationAdd gated by Royalty-DLC presence.
    Stable Vanilla Empire_Caravan_TributeCollector accepts
    Rimconemy_MachineParts and Rimconemy_StainlessSteel as tribute-stock.

  Patch risk: STUFE 1 (Add only). Vanilla traderKindDefs.stockGenerators
    is appended, never replaced.

  Audit-fix E2 (2026-08-05) — Vanilla-1.6 schema compliance:
    (1) The PatchOperationAdd xpath now targets the stockGenerators LIST, not the
        TraderKindDef itself. Prior `<order>Append</order>` against the def appended
        the value <li> as a SIBLING of stockGenerators, where countRange is not a
        TraderKindDef field — the player.log error "doesn't correspond to any field
        in type TraderKindDef" was a parse-time fallout, not a class-name bug.
    (2) StockGenerator_MarketValue in vanilla 1.6 doesn't accept <thingDefCategories>;
        it uses <tradeTag> + <maxTechLevelGenerate> + <countRange>. We instead use
        StockGenerator_Category with <categoryDef> pointing at the custom
        Rimconemy_IndustrialComponents ThingCategoryDef (parent: ResourcesRaw).
        Idempotence guard: not(stockGenerators/li[@Class="StockGenerator_Category"]
        [categoryDef="Rimconemy_IndustrialComponents"]).
-->
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods><li>Ludeon.RimWorld.Royalty</li></mods>
    <match Class="PatchOperationSequence">
      <success>Normal</success>
      <operations>

        <li Class="PatchOperationTest">
          <xpath>/Defs/TraderKindDef[defName="Empire_Caravan_TributeCollector"]/stockGenerators[not(li[@Class="StockGenerator_Category"][categoryDef="Rimconemy_IndustrialComponents"])]</xpath>
        </li>

        <li Class="PatchOperationAdd">
          <xpath>/Defs/TraderKindDef[defName="Empire_Caravan_TributeCollector"]/stockGenerators[not(li[@Class="StockGenerator_Category"][categoryDef="Rimconemy_IndustrialComponents"])]</xpath>
          <order>Append</order>
          <value>
            <li Class="StockGenerator_Category">
              <categoryDef>Rimconemy_IndustrialComponents</categoryDef>
              <thingDefCountRange>2~6</thingDefCountRange>
              <countRange>1~3</countRange>
            </li>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
