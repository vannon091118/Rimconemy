<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Scavenger Infrastructure
  Stable defName: Rimconemy_ConstructionDebris (Save-Contract Pflicht)
  DLC condition: none
  Load order: Core/DLCs -> Harmony -> Foundation -> Survival -> Scavenger -> later packages
  Vanilla anchor: ThingDef (basic resource, ParentName=ResourceBase).
  1.6-Fixes: Graphic_Stacked -> Graphic_StackCount; flammability als Top-Level-Feld gestrichen
  (RimWorld leitet Verbrennbarkeit aus ThingCategory + Material ab, kein freies Feld).

  D3-Harmonisierung (2026-08-05, DECISIONS §29):
    - Konstruktionsmaterial zu Waffen-Komponente umgewidmet.
    - KEIN stuffProps mehr (kein Wall-Stuff); Wall/Door wählen wieder Woody/Metallic/Stony.
    - defName bleibt "Rimconemy_ConstructionDebris" (Save-sicher; alte Stacks
      bleiben unter neuem Label weiter nutzbar).
    - Vor T3 (Automation): nur findbar (Ruinen-Loot, Anomaly/Byproduct-Pfad).
    - Ab T3: craftbar als Waffen-Komponente (Rimconemy_MakeWeaponComponent).

  Owner-Vertrag: das Designer-XML-Label/Description sind Sprache-keyed
  (`{Rimconemy.Scavenger.ConstructionDebris}`), damit DE/EN getrennt
  gepflegt werden.
-->
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>Rimconemy_ConstructionDebris</defName>
    <label>Construction Debris</label>
    <description>Debris from ruined structures, usable for salvaging components.</description>
    <graphicData>
      <texPath>Things/Item/Resource/StoneBlocks</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.9</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <Mass>0.6</Mass>
      <MarketValue>2.5</MarketValue>
    </statBases>
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>
    <!--
      stuffProps wurde bewusst entfernt (D3). Vorher hatte ConstructionDebris
      <categories><li>Stony</li></categories> + statFactors, was es zu einem
      baufähigen Wand-Stuff machte (Phase-Contract §11 jetzt zurückgenommen).
      Wer Stuff-Verhalten zurückbringen will, muss eine neue Decision fällen
      und einen separaten ThingDef dafür wählen.
    -->
    <stackLimit>200</stackLimit>
  </ThingDef>
</Defs>
