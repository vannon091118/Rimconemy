<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Scavenger Infrastructure
  Stable defName: Rimconemy_SalvageMachineParts
  DLC condition: none (Core recipe)
  Load order: Core/DLCs -> Foundation -> Survival -> Scavenger -> later
  Vanilla anchor: RecipeDef (smelting/salvaging).

  Phase-First contract:
    Phase:                Automation (only).
    EarlySurvival phase:  NOT visible (research/Machining gate hides recipe).
    Production phase:     NOT producible.
    Automation phase:     Producible.

  Phase-Gate (XML, real):
    researchPrerequisites: Smithing AND Machining.
      Vanilla Machining research gates TableMachining construction;
      combined with Smithing, the player must cross both Production-phase
      research before this recipe is queued.

  Material economics:
    5 SteelScraps -> 1 Rimconemy_MachineParts (preserved from prior draft).

  Recipe users:
    TableMachining (Phase 3 Automation anchor);
    Rimconemy_Campfire (Phase-1 salvage access if player skipped Smithy route,
                        still gated by both research items).
-->
<Defs>
  <RecipeDef>
    <defName>Rimconemy_SalvageMachineParts</defName>
    <label>salvage machine parts</label>
    <description>Extract gears, actuators, and precision components from steel scraps. Smithing + Machining research unlock the recipe; Automation-phase precision tooling.</description>
    <jobString>Salvaging machine parts</jobString>
    <workAmount>800</workAmount>
    <workSkill>Smithing</workSkill>
    <researchPrerequisites>
      <li>Smithing</li>
      <li>Machining</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Rimconemy_SteelScraps</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Rimconemy_SteelScraps</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Rimconemy_MachineParts>1</Rimconemy_MachineParts>
    </products>
    <recipeUsers>
      <li>Rimconemy_Campfire</li>
      <li>TableMachining</li>
    </recipeUsers>
  </RecipeDef>
</Defs>
