<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Scavenger Infrastructure
  Stable defName: Rimconemy_SalvageMachineParts
  DLC condition: none
  Load order: Core/DLCs -> Harmony -> Foundation -> Survival -> Scavenger -> later packages
  Vanilla anchor: RecipeDef (smelting/salvaging).

  Gameplay: Breaks down steel scraps into machine parts at the campfire.
  Represents precision component recovery from mangled steel.
  Low yield reflects the rarity of intact mechanisms in ruins.
-->
<Defs>
  <RecipeDef>
    <defName>Rimconemy_SalvageMachineParts</defName>
    <label>salvage machine parts</label>
    <description>Carefully extract gears, actuators, and precision components from steel scraps. Most scraps are too damaged, but patient work yields occasional intact machine parts for advanced manufacturing.</description>
    <jobString>Salvaging machine parts</jobString>
    <workAmount>800</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Rimconemy_SteelScraps</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Rimconemy_SteelScraps</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Rimconemy_MachineParts>1</Rimconemy_MachineParts>
    </products>
    <recipeUsers>
      <li>Rimconemy_Campfire</li>
    </recipeUsers>
  </RecipeDef>
</Defs>