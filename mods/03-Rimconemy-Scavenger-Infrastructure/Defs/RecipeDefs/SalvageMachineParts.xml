<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Scavenger Infrastructure
  Stable defName: Rimconemy_SalvageMachineParts
  DLC condition: none
  Load order: Core/DLCs -> Harmony -> Foundation -> Survival -> Scavenger -> later packages
  Vanilla anchor: RecipeDef (salvage/smelting).

  Gameplay: Salvage 5 steel scraps to recover 1 machine part. Low yield represents
  the difficulty of extracting precision components from mangled steel wreckage.
  This is the entry point for the Edelstahl/Tower chain.
-->
<Defs>
  <RecipeDef>
    <defName>Rimconemy_SalvageMachineParts</defName>
    <label>salvage machine parts</label>
    <description>Carefully disassemble steel scraps to recover precision components. Most material is lost in the process — only one in five scraps yields a usable part.</description>
    <jobString>Salvaging machine parts</jobString>
    <workerClass>WorkGiver_DoBill</workerClass>
    <workAmount>600</workAmount>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Rimconemy_SteelScraps</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Rimconemy_SteelScraps</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Rimconemy_MachineParts>1</Rimconemy_MachineParts>
    </products>
    <recipeUsers>
      <li>Rimconemy_Campfire</li>
    </recipeUsers>
    <defaultIngredientCount>5</defaultIngredientCount>
  </RecipeDef>
</Defs>
