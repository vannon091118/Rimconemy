<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Scavenger Infrastructure
  Stable defName: Rimconemy_BurnSteelScraps
  DLC condition: none (Core recipe)
  Load order: Core/DLCs -> Foundation -> Survival -> Scavenger -> later
  Vanilla anchor: RecipeDef (smithing/burning).

  Phase-First contract (PHASE_PROGRESSION_CONTRACT.md §2 + §6):
    Phase:                Production (NOT EarlySurvival, NOT Automation)
    EarlySurvival phase:  Visible (label) + Lootable (ScenPart scatter only)
    Production phase:     Producible (this RecipeDef reached)
    Automation phase:     Producible (still active)

  Material economics (Period 2026-08-05 review):
    5 SteelScraps -> 1 Steel.
    80% mass loss reflects impurity combustion; aligns with PHASE §5 negative
    rule that no EarlySurvival station exposes repeatable Steel production.

  Phase-Gate (XML, real):
    researchPrerequisites: Smithing (Vanilla research project; gated
      indirectly by the FueledSmithy recipeUser list). Player cannot queue
      the recipe on Rimconemy_Campfire before Smithing research completes
      because Rimconemy_ScavengerInfrastructure/About/LoadFolders put
      Rimconemy_Campfire into Phase 1 but the recipe itself is gated by
      the Smithing research project (which also gates FueledSmithy
      construction).

  Recipe users:
    Rimconemy_Campfire (Phase 1 salvage access; deterministic).
    FueledSmithy (Phase 2 Production anchor; productivity > campfire speed).
-->
<Defs>
  <RecipeDef>
    <defName>Rimconemy_BurnSteelScraps</defName>
    <label>burn steel scraps</label>
    <description>Burn down steel scraps to reclaim usable steel. Five pile of scrap burn down to one ingot's worth of reclaimed steel; the impurity loss is the price of salvage. Production-phase recipe — gated by Smithing research.</description>
    <jobString>Burning steel scraps</jobString>
    <workAmount>600</workAmount>
    <!-- Audit-fix E1 (2026-08-05): SkillDef "Smithing" was merged into "Crafting"
         in vanilla RimWorld 1.6 Core. ResearchProject defName "Smithing" still
         exists (only the *SkillDef* was renamed), so the research gate is
         unchanged. -->
    <workSkill>Crafting</workSkill>
    <researchPrerequisites>
      <li>Smithing</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Rimconemy_SteelScraps</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Rimconemy_SteelScraps</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Steel>1</Steel>
    </products>
    <recipeUsers>
      <li>Rimconemy_Campfire</li>
      <li>FueledSmithy</li>
    </recipeUsers>
  </RecipeDef>
</Defs>
