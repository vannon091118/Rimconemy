<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Scavenger Infrastructure
  Stable defName: Rimconemy_MakeCoal
  DLC condition: none (Core recipe)
  Load order: Core/DLCs -> Foundation -> Survival -> Scavenger -> later
  Vanilla anchor: RecipeDef (smithing/burning).

  Phase-First contract (PHASE_PROGRESSION_CONTRACT.md §2 + §6):
    Phase:                Automation (NOT EarlySurvival, NOT Production).
    EarlySurvival phase:  NOT visible (research gate keeps the recipe hidden
                          from the bill list before Coal Synthesis).
    Production phase:     NOT producible (Coal Synthesis still locked).
    Automation phase:     Producible (after research + workSkill gate).

  Skill gate (Period 2026-08-05 review-fix + Audit-fix E1 2026-08-05):
    workSkill = Crafting (Pyrolysis IS smithing thermodynamics, which 1.6
      rolls up under the Crafting SkillDef; the legacy "Smithing" SkillDef
      was merged into Crafting in vanilla RimWorld 1.6 — using "Smithing"
      here would crash def-load with "No SkillDef named Smithing").
    skillRequirements: Crafting >= 3 — successful smelting requires a basic
      understanding of fuel oxidation.

  Phase-Gate (XML, real):
    researchPrerequisites: Smithing — ResearchProject *defName* still exists
      in 1.6 Core (only the SkillDef was renamed to Crafting). Until Smithing
      research completes, this recipe is hidden from the bill list on
      Rimconemy_Campfire.

  Material economics:
    3 WoodLog + 2 Rimconemy_HempLeafy -> 4 Rimconemy_Coal.

  Recipe users:
    Rimconemy_Campfire (Phase-1 salvage access, gated by Smithing + Smithing >= 3).
-->
<Defs>
  <RecipeDef>
    <defName>Rimconemy_MakeCoal</defName>
    <label>make coal</label>
    <description>Pyrolyse wood and hemp fibre in a hot, oxygen-poor chamber to drive off volatiles and concentrate carbon. Coal Synthesis research gates availability; requires Smithing 3 — a refiner's understanding of how volatiles depart.</description>
    <jobString>Making coal</jobString>
    <workAmount>500</workAmount>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <Crafting>3</Crafting>
    </skillRequirements>
    <researchPrerequisites>
      <li>Smithing</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Rimconemy_HempLeafy</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>WoodLog</li>
        <li>Rimconemy_HempLeafy</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Rimconemy_Coal>4</Rimconemy_Coal>
    </products>
    <recipeUsers>
      <li>Rimconemy_Campfire</li>
    </recipeUsers>
  </RecipeDef>
</Defs>
