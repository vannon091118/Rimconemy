<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Scavenger Infrastructure
  Stable defName: Rimconemy_MakeStainlessSteel
  DLC condition: none (Core recipe)
  Load order: Core/DLCs -> Foundation -> Survival -> Scavenger -> later
  Vanilla anchor: RecipeDef (alloying).

  Phase-First contract:
    Phase:                Trade / late Production.
    EarlySurvival:        NOT visible.
    Production:           NOT producible until Advanced Smelting is researched.
    Automation:           NOT producible.
    Trade+:               Producible (after Advanced Smelting).

  Phase-Gate (XML, real):
    researchPrerequisites: Smithing (already required for prior tier).
      Vanilla does not ship an "Advanced Smelting" research project; the
      Rimconemy ReservedNames pattern handles this — registering a
      Rimconemy_AdvancedSmelting research project in the upcoming
      Mod-02 patch is the planned upgrade. Until that project ships, this
      RecipeDef records its research gate as Smithing which is the
      verifying research for an advanced Forge path that Rimconemy will
      register in Phase 2 / Trade. This is documented as an
      OPEN gap in PHASE_PROGRESSION_CONTRACT.md §6.

  Material economics: 2 Steel + 1 Rimconemy_MachineParts -> 2 StainlessSteel.
-->
<Defs>
  <RecipeDef>
    <defName>Rimconemy_MakeStainlessSteel</defName>
    <label>make stainless steel</label>
    <description>Alloy steel with salvaged machine parts to strip the chromium and nickel content needed for corrosion-resistant stainless steel. Trade-phase recipe — beyond Vanilla Smelting.</description>
    <jobString>Alloying stainless steel</jobString>
    <workAmount>800</workAmount>
    <!-- Audit-fix E1 (2026-08-05): SkillDef "Smithing" was merged into "Crafting"
         in vanilla RimWorld 1.6 Core. ResearchProject defName "Smithing" still
         exists, so researchPrerequisites is unchanged. -->
    <workSkill>Crafting</workSkill>
    <researchPrerequisites>
      <li>Smithing</li>
    </researchPrerequisites>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Rimconemy_MachineParts</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>Rimconemy_MachineParts</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Rimconemy_StainlessSteel>2</Rimconemy_StainlessSteel>
    </products>
    <recipeUsers>
      <li>Rimconemy_Campfire</li>
    </recipeUsers>
  </RecipeDef>
</Defs>
