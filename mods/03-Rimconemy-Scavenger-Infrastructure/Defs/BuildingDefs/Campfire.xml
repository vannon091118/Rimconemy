<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Scavenger Infrastructure
  Stable defName: Rimconemy_Campfire
  DLC condition: none
  Load order: Core/DLCs -> Harmony -> Foundation -> Survival -> Scavenger -> later packages
  Vanilla anchor: ThingDef (Building, workbench-like).
  1.6-Fixes: tickerType=Normal for CompRefuelable; CompProperties_Fire removed
    (invalid for Building_WorkTable in 1.6 — ConfigError). CompProperties_Glower
    provides the visual fire effect instead.

  Gameplay: The campfire is the first processing building. It burns steel scraps
  (scavenged from ruins) and reclaims usable steel. This is the core loop:
  Scavenge ruins → find steel scraps → burn in campfire → get steel → build walls.

  The campfire is intentionally simple: no power, no research, just fire + scraps = steel.
-->
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Rimconemy_Campfire</defName>
    <label>scrap campfire</label>
    <description>A crude fire pit where steel scraps are burned down to reclaim usable steel. The first step in the scavenging loop: ruins yield scraps, the campfire yields building material.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/Campfire</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.3</drawSize>
    </graphicData>
    <tickerType>Normal</tickerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <recipes>
      <li>Rimconemy_BurnSteelScraps</li>
      <li>Rimconemy_MakeCoal</li>
      <li>Rimconemy_SalvageMachineParts</li>
      <li>Rimconemy_MakeStainlessSteel</li>
      <li>Rimconemy_MakeWeaponComponent</li>
    </recipes>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(255,200,100,200)</glowColor>
      </li>
    </comps>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <MarketValue>150</MarketValue>
      <Mass>5</Mass>
      <WorkTableWorkSpeedFactor>1.0</WorkTableWorkSpeedFactor>
    </statBases>
    <thingCategories>
      <li>Rimconemy_CraftingStations</li>
    </thingCategories>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <passability>PassThroughOnly</passability>
    <size>(1,1)</size>
  </ThingDef>
</Defs>
