<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Infected & Automation
  defName: Rimconemy_InfectedWildlifeAggression
  Phase E — Animal-Infektion Speed-Boost + Marker-Hediff.

  - statOffsets/MoveSpeed=0.5 → +50% Bewegungsgeschwindigkeit auf
    konvertierten Wildtieren. Verdoppelt das ursprüngliche Tier-Tempo
    ohne das Race direkt zu mutieren (so bleibt der Vanilla Tier-Tag
    "Wolf/Bear/etc." visuell erhalten).
  - HediffWithComps (Stat-Offset only) — kein Severity-Decay, keine
    Stages. Permanent bis pawn.Destroyed.
  - isInfection=true damit Health-Tab den Tier als infiziert markiert.
-->
<Defs>
  <HediffDef ParentName="DiseaseBase">
    <defName>Rimconemy_InfectedWildlifeAggression</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>infected wildlife aggression</label>
    <labelNoun>infected wildlife</labelNoun>
    <defaultLabelColor>(0.85, 0.20, 0.20)</defaultLabelColor>
    <isInfection>true</isInfection>
    <statOffsets>
      <MoveSpeed>0.5</MoveSpeed>
    </statOffsets>
    <comps/>
  </HediffDef>
</Defs>
