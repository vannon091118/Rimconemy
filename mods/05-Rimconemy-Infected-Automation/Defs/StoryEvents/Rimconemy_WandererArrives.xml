<?xml version="1.0" encoding="utf-8"?>
<!--
  Rimconemy_WandererArrives — Wanderer
  Owner: Infected & Automation (Story-Domäne)
  Status: ACTIVE — wird vom StoryEventCatalog.MergeFromDefDatabase() geladen.
  Band: 1 (Refuge), Familie: Social
  Reagiert auf: < 8 Kolonisten, 5+ Tage seit Spielstart, Mood < 0.7
-->
<Defs>
  <Rimconemy.InfectedAutomation.Story.StoryEventDef>
    <defName>rimconemy_social_wanderer_arrives</defName>
    <label>Wanderer</label>
    <description>Ein Fremder bittet um Aufnahme in die Gruppe.</description>

    <eventVersion>1</eventVersion>
    <eventFamily>Social</eventFamily>
    <escalationBand>1</escalationBand>
    <escalationTarget>IdeologyTension</escalationTarget>
    <escalationModifier>0.0</escalationModifier>

    <prerequisites>
      <li>MaxActiveEvents()</li>
      <li>NOT ActiveEvent(Social)</li>
      <li>ColonistCountBelow(8)</li>
      <li>DaysSinceStartAbove(5)</li>
    </prerequisites>

    <exclusions>
      <li>MoodAbove(0.7)</li>
      <li>DaysSinceLastEventBelow(3.0)</li>
    </exclusions>

    <weights>
      <li>Rimconemy_Refuge=15</li>
      <li>Rimconemy_Survival=20</li>
    </weights>

    <cooldownDays>
      <li>Rimconemy_Refuge=15.0</li>
      <li>Rimconemy_Survival=12.0</li>
    </cooldownDays>

    <textKey>Rimconemy_WandererArrives_Letter</textKey>
    <letterLabel>Fremder nähert sich</letterLabel>
    <letterText>Ein Wanderer hat die Siedlung erreicht und bittet um Aufnahme. Er scheint arbeitsfähig und friedlich.</letterText>

    <choices>
      <li Class="Rimconemy.InfectedAutomation.Story.StoryEventChoiceDef">
        <choiceId>Accept</choiceId>
        <label>Aufnehmen</label>
        <effects>
          <li>AddColonist:Wanderer</li>
          <li>MoodModifier:+2 for 2 days</li>
        </effects>
      </li>
      <li Class="Rimconemy.InfectedAutomation.Story.StoryEventChoiceDef">
        <choiceId>Decline</choiceId>
        <label>Abweisen</label>
        <effects>
          <li>MoodModifier:-1 for 1 day</li>
          <li>OpinionChange:-5</li>
        </effects>
      </li>
    </choices>

    <followUpIds />
    <determinismKey>{ProfileId}+{EventId}+{PawnId}+{GameTickDay}</determinismKey>
  </Rimconemy.InfectedAutomation.Story.StoryEventDef>
</Defs>
