<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Phase-2.7 (2026-08-04): Begleit-Hediff Rimconemy_NeedAmplifier.

    Hook-Mechanik OHNE Harmony-Transpiler: die Hediff-Klasse
    Hediff_NeedAmplifier ueberschreibt die vanilla-virtuelle Property
    Hediff.HungerRateFactor. Vanilla iteriert in HediffSet.GetHungerRateFactor()
    ueber alle Hediffs und multipliziert deren Werte; unser Override liefert
    den NeedAmplifier.AmplifierFactor(need.CurLevelPercentage) in [0.7, 1.4]
    und uebertraegt damit den Sample-Amplifier in Vanilla-Hunger-Tick.

    Owner: Survival & Progression (Paket 02). Sole-Owner per
    INTERFACE_CONTRACT §9.1 — kein Cross-Package-Schreiben.

    Q14-Contract: Setting-NeedDefs werden NICHT an Pawns angehaengt; das
    hier ist ein eigenstaendiges Hediff ohne Setting-Need-Coupling.

    Code-Reviewer-Pass 2026-08-04: capMods in den Stages entfernt — die
    HungerRate-Wert-Multiplikation kommt allein aus dem Hediff-Override,
    nicht aus vanilla-Capacity-capMods. Stages sind reine Labels fuer die
    Severity-Bereichszuordnung.

    Stage-Schwellen vs SeverityOffset:
      satiated: minSeverity 0.05  (Sample 1.0 → Severity 0.05)
      neutral:  minSeverity 0.45  (Sample 0.5 → Severity 0.50)
      hungry:   minSeverity 0.85  (Sample 0.0 → Severity 1.00)
  -->
  <HediffDef ParentName="DiseaseBase">
    <defName>Rimconemy_NeedAmplifier</defName>
    <hediffClass>Rimconemy.SurvivalProgression.Needs.Hediff_NeedAmplifier</hediffClass>
    <defaultSeverity>0.5</defaultSeverity>
    <!-- Min-Severity 0.05: bleicht ueber Lifetime non-negative.
         NeedAmplifier.SeverityOffset() mappt in [0.05, 1.0] -->
    <minSeverity>0.05</minSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <scenarioCanAdd>true</scenarioCanAdd>
    <comps>
      <!-- Belt-and-Suspenders: severityPerDay=0 plus Klassen-Override
           TendencySeverityChangePerDay=0. Beide verhindern Severity-Drift
           unabhaengig voneinander via vanilla-Code-Pfade. -->
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>0</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>satiated</label>
        <minSeverity>0.0</minSeverity>
      </li>
      <li>
        <label>neutral</label>
        <minSeverity>0.45</minSeverity>
      </li>
      <li>
        <label>hungry</label>
        <minSeverity>0.85</minSeverity>
      </li>
    </stages>
  </HediffDef>
</Defs>
