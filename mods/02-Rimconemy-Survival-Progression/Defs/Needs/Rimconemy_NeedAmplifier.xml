<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    Phase-2.7 (2026-08-04): Begleit-Hediff Rimconemy_NeedAmplifier.

    Hook-Mechanik OHNE Harmony-Transpiler: RimWorld 1.6 liest
    hungerRateFactor aus der aktuellen HediffStage in
    HediffSet.GetHungerRateFactor(). Hediff_NeedAmplifier spiegelt den
    Vanilla-Food-Sample in Severity; die XML-Stages liefern daraus 0.7,
    1.0 oder 1.4 fuer den nativen Hunger-Tick.

    Owner: Survival & Progression (Paket 02). Sole-Owner per
    INTERFACE_CONTRACT §9.1 — kein Cross-Package-Schreiben.

    Q14-Contract: Setting-NeedDefs werden NICHT an Pawns angehaengt; das
    hier ist ein eigenstaendiges Hediff ohne Setting-Need-Coupling.

    Code-Reviewer-Pass 2026-08-04: keine Hediff-Comps noetig. Die
    Severity wird direkt von der eigenen Hediff-Klasse aktualisiert; die
    Stage-Werte sind die native RimWorld-1.6-Hunger-Multiplikation.

    Stage-Schwellen vs SeverityOffset:
      satiated: minSeverity 0.05  (Sample 1.0 → Severity 0.05)
      neutral:  minSeverity 0.45  (Sample 0.5 → Severity 0.50)
      hungry:   minSeverity 0.85  (Sample 0.0 → Severity 1.00)
  -->
  <HediffDef>
    <defName>Rimconemy_NeedAmplifier</defName>
    <label>need amplifier</label>
    <hediffClass>Rimconemy.SurvivalProgression.Needs.Hediff_NeedAmplifier</hediffClass>
    <initialSeverity>0.5</initialSeverity>
    <description>Amplifies the vanilla hunger rate from the survival progression need sample.</description>
    <!-- Min-Severity 0.05: bleicht ueber Lifetime non-negative.
         NeedAmplifier.SeverityOffset() mappt in [0.05, 1.0] -->
    <minSeverity>0.05</minSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <scenarioCanAdd>true</scenarioCanAdd>
    <stages>
      <li>
        <label>satiated</label>
        <minSeverity>0.0</minSeverity>
        <hungerRateFactor>0.7</hungerRateFactor>
      </li>
      <li>
        <label>neutral</label>
        <minSeverity>0.45</minSeverity>
        <hungerRateFactor>1.0</hungerRateFactor>
      </li>
      <li>
        <label>hungry</label>
        <minSeverity>0.85</minSeverity>
        <hungerRateFactor>1.4</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>
</Defs>
