<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Survival & Progression (Package 02)
  Phase 2.1 — Stahlreste als physische Ressource.
  Vanilla anchor: ThingDef (ParentName=ResourceBase), stuffProps.Stony.
  Diese Ressource wird im SingleSurvivor-Setup gestreut (ScenPart_RimconemyStart).
  Stuff-Kategorie erm\u00f6glicht sp\u00e4teren Bau als Wand/T\u00fcr-Material (Phase 4.1).
  Wichtig: Discovered-by-Survival, nicht garantiert. Anti-Softlock (DECISIONS \u00a724).
-->
<Defs>

  <ThingDef Name="Rimconemy_SteelScraps" ParentName="ResourceBase">
    <defName>Rimconemy_SteelScraps</defName>
    <label>Stahlreste</label>
    <description>Geborgene Stahlreste aus einer zerst\u00f6rten Welt. Lassen sich im Campfire zu nutzbarem Stahl verarbeiten, sind aber nicht garantiert in jeder Kampagne zu finden.</description>
    <thingClass>ThingWithComps</thingClass>
    <soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
    <canBeSpawningFloors>true</canBeSpawningFloors>
    <category>Resources</category>
    <techLevel>Neolithic</techLevel>
    <generateCommonality>0.0</generateCommonality>

    <statBases>
      <MarketValue>0.6</MarketValue>
      <Mass>0.3</Mass>
      <DeteriorationRate>0.7</DeteriorationRate>
    </statBases>

    <stackLimit>75</stackLimit>

    <stuffProps>
      <commonality>0.6</commonality>
      <categories>
        <li>Stony</li>
      </categories>
      <colorFactors>
        <li>(0.45, 0.45, 0.5, 1)</li>
      </colorFactors>
    </stuffProps>

    <graphicData>
      <texPath>Things/Item/Resource/Steel</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>

    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Flammable">
        <flammability>0.4</flammability>
      </li>
    </comps>
  </ThingDef>

</Defs>
