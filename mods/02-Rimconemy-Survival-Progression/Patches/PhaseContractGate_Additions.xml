<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Survival & Progression (Package 02).
  PHASE_PROGRESSION_CONTRACT §11 (Phase-2 hardening 2026-08-05).

  Attaches PhaseContractGate DefModExtension (earlyPhaseActive=true) to
  Wall / DoorBase / Barricade. For each def we use TWO EXCLUSIVE
  PatchOperationConditional branches, gated on the existence of the
  <modExtensions> container at def-load time:

    A. <modExtensions> ALREADY EXISTS (an upstream mod pre-stamped it):
       gate with [modExtensions], then nest a PatchOperationAdd whose
       xpath targets <modExtensions> directly to inject <li>.

    B. <modExtensions> DOES NOT EXIST (fresh vanilla):
       gate with [not(modExtensions)], then nest a PatchOperationAdd
       whose xpath targets the ThingDef root with a <modExtensions>
       container as the add body to mint the container.

  Both branches use PatchOperationConditional+match (engine-native
  idempotent pattern from the §11 doctrine) — never a raw PatchOperationAdd
  to /modExtensions, which causes Verse to emit Log.Error when the
  container is absent.

  Revocation path: removing PhaseContractGate from these defs causes
  the dependent Mod-03 patches (Stufe 2 in §11) to silently no-op.

  Sandbag is dropped (verified absent from vanilla 1.6.4566 Core + DLC
  Data folders via grep -rln 'defName="Sandbag"' game/Data/ returning
  empty). Adding a Sandbag branch re-emerges only on community demand.
-->
<Patch>

  <!-- ══════════════ WALL ══════════════ -->
  <Operation Class="PatchOperationConditional" MayRequire="rimconemy.survivalprogression">
    <xpath>/Defs/ThingDef[defName="Wall"][modExtensions]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Wall"]/modExtensions</xpath>
      <value>
        <li Class="Rimconemy.SurvivalProgression.Phase.PhaseContractGate">
          <earlyPhaseActive>true</earlyPhaseActive>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional" MayRequire="rimconemy.survivalprogression">
    <xpath>/Defs/ThingDef[defName="Wall"][not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Wall"]</xpath>
      <value>
        <modExtensions>
          <li Class="Rimconemy.SurvivalProgression.Phase.PhaseContractGate">
            <earlyPhaseActive>true</earlyPhaseActive>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- ══════════════ DOOR (via DoorBase ParentName injection — single patch for all doors) ══════════════ -->
  <Operation Class="PatchOperationConditional" MayRequire="rimconemy.survivalprogression">
    <xpath>/Defs/ThingDef[@Name="DoorBase"][modExtensions]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[@Name="DoorBase"]/modExtensions</xpath>
      <value>
        <li Class="Rimconemy.SurvivalProgression.Phase.PhaseContractGate">
          <earlyPhaseActive>true</earlyPhaseActive>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional" MayRequire="rimconemy.survivalprogression">
    <xpath>/Defs/ThingDef[@Name="DoorBase"][not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[@Name="DoorBase"]</xpath>
      <value>
        <modExtensions>
          <li Class="Rimconemy.SurvivalProgression.Phase.PhaseContractGate">
            <earlyPhaseActive>true</earlyPhaseActive>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

  <!-- ══════════════ BARRICADE ══════════════ -->
  <Operation Class="PatchOperationConditional" MayRequire="rimconemy.survivalprogression">
    <xpath>/Defs/ThingDef[defName="Barricade"][modExtensions]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Barricade"]/modExtensions</xpath>
      <value>
        <li Class="Rimconemy.SurvivalProgression.Phase.PhaseContractGate">
          <earlyPhaseActive>true</earlyPhaseActive>
        </li>
      </value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional" MayRequire="rimconemy.survivalprogression">
    <xpath>/Defs/ThingDef[defName="Barricade"][not(modExtensions)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="Barricade"]</xpath>
      <value>
        <modExtensions>
          <li Class="Rimconemy.SurvivalProgression.Phase.PhaseContractGate">
            <earlyPhaseActive>true</earlyPhaseActive>
          </li>
        </modExtensions>
      </value>
    </match>
  </Operation>

</Patch>
