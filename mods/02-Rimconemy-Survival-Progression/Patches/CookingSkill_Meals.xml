      <value><li Class="Rimconemy.SurvivalProgression.Character.Cooking.CompProperties_CookSkill" /></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional" MayRequire="rimconemy.survivalprogression">
    <xpath>/Defs/ThingDef[defName="MealFine"][not(comps)]</xpath>
    <match Class="PatchOperationAdd">
