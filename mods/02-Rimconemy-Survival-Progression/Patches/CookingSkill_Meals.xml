<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner: Survival & Progression (Package 02).
  Cooking role layer: tag every cooked meal with CompCookSkill so the
  prepared-by skill survives on the product (CookingEffects.cs).

  Anchor: `MealCookedIngredientless` is the common abstract ancestor of
  MealSimple, MealFine and MealLavish (and their _Veg/_Meat variants).
  Vanilla chain: MealBaseIngredientless -> MealCookedIngredientless ->
  {MealCooked, MealFineBase, MealLavishBase} -> concrete defs.
  `MealBase` itself only parents MealSurvivalPack/MealNutrientPaste and is
  NOT on the cooked-meal path.

  RimWorld merges comps lists across inheritance, so children that define
  their own <comps> block (e.g. MealFine with CompProperties_Ingredients)
  still inherit this entry. The not(li[...]) guard keeps the patch
  idempotent.
-->
<Patch>
  <Operation Class="PatchOperationConditional" MayRequire="rimconemy.survivalprogression">
    <xpath>/Defs/ThingDef[@Name="MealCookedIngredientless"]/comps[not(li[@Class="Rimconemy.SurvivalProgression.Character.Cooking.CompProperties_CookSkill"])]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[@Name="MealCookedIngredientless"]/comps[not(li[@Class="Rimconemy.SurvivalProgression.Character.Cooking.CompProperties_CookSkill"])]</xpath>
      <value><li Class="Rimconemy.SurvivalProgression.Character.Cooking.CompProperties_CookSkill" /></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional" MayRequire="rimconemy.survivalprogression">
    <xpath>/Defs/ThingDef[@Name="MealCookedIngredientless"][not(comps)]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[@Name="MealCookedIngredientless"]</xpath>
      <value><comps><li Class="Rimconemy.SurvivalProgression.Character.Cooking.CompProperties_CookSkill" /></comps></value>
    </match>
  </Operation>
</Patch>
