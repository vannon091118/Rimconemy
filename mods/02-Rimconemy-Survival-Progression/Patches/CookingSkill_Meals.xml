    </match>
  </Operation>
  <Operation Class="PatchOperationConditional" MayRequire="rimconemy.survivalprogression">
    <xpath>/Defs/ThingDef[defName="MealLavish"]/comps[not(li[@Class="Rimconemy.SurvivalProgression.Character.Cooking.CompProperties_CookSkill"])]</xpath>
    <match Class="PatchOperationAdd">
