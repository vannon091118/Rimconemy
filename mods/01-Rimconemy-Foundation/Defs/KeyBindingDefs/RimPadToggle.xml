<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!--
    Owner: Foundation (Package 01)
    Key binding to toggle RimPad floating dashboard.
    Default: Ctrl+T
  -->
  <KeyBindingDef>
    <defName>Rimconemy_RimPadToggle</defName>
    <label>RimPad Toggle</label>
    <description>Toggle the RimPad floating dashboard</description>
    <keyCode>T</keyCode>
    <modifiers>
      <li>Ctrl</li>
    </modifiers>
  </KeyBindingDef>
</Defs>