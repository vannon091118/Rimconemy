        <Value>false</Value>
      </li>
      <li Class="Rimconemy.Foundation.DLC.DLCPolicyEntry">
        <PolicyPath>Royalty.QuestsAndShuttles</PolicyPath>
        <Value>false</Value>
      </li>

      <!-- Ideology: ThoughtSystem an, Rest suppressed -->
      <li Class="Rimconemy.Foundation.DLC.DLCPolicyEntry">
        <PolicyPath>Ideology.ThoughtSystem</PolicyPath>
        <Value>true</Value>
      </li>
      <li Class="Rimconemy.Foundation.DLC.DLCPolicyEntry">
