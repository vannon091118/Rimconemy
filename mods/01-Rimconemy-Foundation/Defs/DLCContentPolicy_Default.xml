      <!-- Anomaly: Shamblers an (genetische Basis), Rest suppressed -->
      <li Class="Rimconemy.Foundation.DLC.DLCPolicyEntry">
        <PolicyPath>Anomaly.Shamblers</PolicyPath>
        <Value>true</Value>
      </li>
      <li Class="Rimconemy.Foundation.DLC.DLCPolicyEntry">
