<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Rimconemy.Foundation</AssemblyName>
    <RootNamespace>Rimconemy.Foundation</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(IsolatedOutputPath)' == ''">Assemblies/</OutputPath>
    <OutputPath Condition="'$(IsolatedOutputPath)' != ''">$(IsolatedOutputPath)</OutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDepsFile>false</GenerateDepsFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssembliesPath)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      Audit-fix K2 (2026-08-05, corrected): Mono.Cecil must be shipped as a
      COPY-LOCAL Reference, not a PackageReference. Verified 2026-08-05:
      (a) RimWorldLinux_Data/Managed and the Harmony mod folder ship NO
      Mono.Cecil.dll on this install — FoundationHonestBannerAudit runs in
      Bootstrap (StaticConstructorOnStartup) and needs the DLL at boot.
      (b) A PackageReference (even without ExcludeAssets=runtime) does NOT
      copy Mono.Cecil.dll into OutputPath=Assemblies/ in this SDK setup — the
      boot would TypeLoadException. <Private>true</Private> on the Reference
      is the proven copy-local form (matches the originally deployed mod).
      DebugType=none already suppresses the .pdb. The NuGet cache path is
      overridable via -p:MonoCecilHintPath=... on the command line.
    -->
    <Reference Include="Mono.Cecil">
      <HintPath Condition="'$(MonoCecilHintPath)' == ''">$(HOME)/.nuget/packages/mono.cecil/0.11.5/lib/netstandard2.0/Mono.Cecil.dll</HintPath>
      <HintPath Condition="'$(MonoCecilHintPath)' != ''">$(MonoCecilHintPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateReferencePaths" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldManagedPath)' == ''" Text="RimWorldManagedPath is required. Pass -p:RimWorldManagedPath=.../RimWorldLinux_Data/Managed" />
    <Error Condition="!Exists('$(RimWorldManagedPath)/Assembly-CSharp.dll')" Text="Assembly-CSharp.dll not found under $(RimWorldManagedPath)" />
    <Error Condition="'$(HarmonyAssembliesPath)' == ''" Text="HarmonyAssembliesPath is required. Pass -p:HarmonyAssembliesPath=.../Harmony/Current/Assemblies" />
    <Error Condition="!Exists('$(HarmonyAssembliesPath)/0Harmony.dll')" Text="0Harmony.dll not found under $(HarmonyAssembliesPath)" />
  </Target>
</Project>
