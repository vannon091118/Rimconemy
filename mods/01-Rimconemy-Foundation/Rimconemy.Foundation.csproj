<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Rimconemy.Foundation</AssemblyName>
    <RootNamespace>Rimconemy.Foundation</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(IsolatedOutputPath)' == ''">Assemblies/</OutputPath>
    <OutputPath Condition="'$(IsolatedOutputPath)' != ''">$(IsolatedOutputPath)</OutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDepsFile>false</GenerateDepsFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManagedPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManagedPath)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyAssembliesPath)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      Phase 8.6 (2026-08-05): Mono.Cecil reference for FoundationHonestBannerAudit.
      Replaces raw IL-Byte-Pattern-Scan with a proper Cecil MethodDefinition walker.
      The HintPath is set to the local-only NuGet cache so the build needs no
      network round-trip (Mono.Cecil 0.11.5 ships netstandard2.0-only).
      Path is overridable via -p:MonoCecilHintPath=... on the command line.
      <Private>true</Private> ⇒ Mono.Cecil.dll is copied to Assemblies/ and
      shipped with the mod (RimWorld's mod loader will pick it up).
    -->
    <Reference Include="Mono.Cecil">
      <HintPath Condition="'$(MonoCecilHintPath)' == ''">/home/vannon/.nuget/packages/mono.cecil/0.11.5/lib/netstandard2.0/Mono.Cecil.dll</HintPath>
      <HintPath Condition="'$(MonoCecilHintPath)' != ''">$(MonoCecilHintPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateReferencePaths" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorldManagedPath)' == ''" Text="RimWorldManagedPath is required. Pass -p:RimWorldManagedPath=.../RimWorldLinux_Data/Managed" />
    <Error Condition="!Exists('$(RimWorldManagedPath)/Assembly-CSharp.dll')" Text="Assembly-CSharp.dll not found under $(RimWorldManagedPath)" />
    <Error Condition="'$(HarmonyAssembliesPath)' == ''" Text="HarmonyAssembliesPath is required. Pass -p:HarmonyAssembliesPath=.../Harmony/Current/Assemblies" />
    <Error Condition="!Exists('$(HarmonyAssembliesPath)/0Harmony.dll')" Text="0Harmony.dll not found under $(HarmonyAssembliesPath)" />
  </Target>
</Project>
