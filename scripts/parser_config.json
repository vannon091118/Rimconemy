{
  "_schema": "1.1",
  "_description": "Preflight-Config für parse_runtime_log.py. Jeder Eintrag definiert, WAS der Parser im Player.log finden MUSS. Neue Funktionen/Umbenennungen: nur hier nachtragen.",

  "bootstrap": {
    "min_packages": 5,
    "min_profiles": 1,
    "required_markers": [
      "bootstrap START",
      "bootstrap COMPLETE"
    ],
    "required_packages": [
      "rimconemy.foundation",
      "rimconemy.survivalprogression",
      "rimconemy.scavengerinfrastructure",
      "rimconemy.economyterritory",
      "rimconemy.infectedautomation"
    ],
    "required_profiles": [
      "FullOverhaul"
    ]
  },

  "test_suites": {
    "_note": "Jede Suite MUSS im Log erscheinen mit 'X passed, 0 failed'. package=NUM für --focused Filter.",
    "required": [
      {"package": "01", "pattern": "CapabilityGate tests: \\d+ passed, 0 failed"},
      {"package": "01", "pattern": "ColonialReader tests: \\d+ passed, 0 failed"},
      {"package": "01", "pattern": "CrossPackageState tests: \\d+ passed, 0 failed"},
      {"package": "01", "pattern": "EventLog regression tests: \\d+ passed, 0 failed"},
      {"package": "01", "pattern": "Profile refresh tests: \\d+ passed, 0 failed"},
      {"package": "01", "pattern": "Profile detector dedup tests: \\d+ passed, 0 failed"},
      {"package": "01", "pattern": "Honest-Banner-Audit tests: \\d+/\\d+ passed, 0 failed"},
      {"package": "01", "pattern": "Canonical layer tests: \\d+ passed, 0 failed"},
      {"package": "02", "pattern": "BioRemap tests: \\d+ passed, 0 failed"},
      {"package": "02", "pattern": "NeedMappingService tests: \\d+ passed, 0 failed"},
      {"package": "02", "pattern": "DomainXpState tests: \\d+ passed, 0 failed"},
      {"package": "02", "pattern": "UnlockService tests: \\d+ passed, 0 failed"},
      {"package": "02", "pattern": "BuildingCompletionBridge tests: \\d+ passed, 0 failed"},
      {"package": "02", "pattern": "SchemaBump tests: \\d+ passed, 0 failed"},
      {"package": "02", "pattern": "PhaseProgress regression tests: \\d+ passed, 0 failed"},
      {"package": "03", "pattern": "ArrowTurretBlock tests: \\d+ passed, 0 failed"},
      {"package": "03", "pattern": "BauschuttRemapApply tests: \\d+ passed, 0 failed"},
      {"package": "03", "pattern": "BuildingCore regression tests: \\d+ passed, 0 failed"},
      {"package": "03", "pattern": "CampfireScraps regression tests: \\d+ passed, 0 failed"},
      {"package": "03", "pattern": "CoalChain regression tests: \\d+ passed, 0 failed"},
      {"package": "03", "pattern": "StainlessSteelChain regression tests: \\d+ passed, 0 failed"},
      {"package": "03", "pattern": "CaravanStorageRegressionTests PASS"},
      {"package": "04", "pattern": "CreditsLedger regression tests: \\d+ passed, 0 failed"},
      {"package": "04", "pattern": "Market persistence tests: \\d+ passed, 0 failed"},
      {"package": "04", "pattern": "Physical transfer regression tests: \\d+ passed, 0 failed"},
      {"package": "04", "pattern": "Outpost investment regression tests: \\d+ passed, 0 failed"},
      {"package": "04", "pattern": "Building input regression tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "StorySelector tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "StoryState regression tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "TutorialDirector tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "PopulationLedger regression tests \\(Phase A subset\\): \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "Revenge-quota flow regression tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "HordeManifest tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "ThreatSnapshotBridge regression tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "Building threat regression tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "Mechadroid job regression tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "StartEnemies regression tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "Building progression regression tests: \\d+ passed, 0 failed"},
      {"package": "05", "pattern": "Building progression persistence tests: \\d+ passed, 0 failed"}
    ]
  },

  "forbidden": {
    "_note": "Patterns die im Log NICHT vorkommen dürfen (Fehler-Indikatoren).",
    "patterns": [
      "Config error in Rimconemy_Campfire",
      "CA9011A3",
      "abstract class",
      "Exception loading def from file",
      "marketSnapshot",
      "is not a valid value for Verse.ThingCategory",
      "non-power-of-two dimensions"
    ]
  },

  "runtime_markers": {
    "_note": "Marker die im Log vorhanden sein MÜSSEN für einen gültigen Boot.",
    "required": [
      "RimWorld 1\\.6\\.",
      "\\[Rimconemy\\.Foundation\\] Bootstrap complete\\.",
      "Profile detected: FullOverhaul",
      "Registry: 5 package\\(s\\) registered"
    ]
  },

  "cross_refs": {
    "_note": "Cross-Reference-Warnings — sollten 0 sein. Max akzeptiert = 0.",
    "max_allowed": 0
  },

  "focused_packages": {
    "_description": "Focused-Mode: wenn --focused <pkg> gesetzt, nur Suites dieses Pakets prüfen.",
    "package_map": {
      "01": "Foundation",
      "02": "SurvivalProgression",
      "03": "ScavengerInfrastructure",
      "04": "EconomyTerritory",
      "05": "InfectedAutomation"
    }
  }
}
